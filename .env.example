# Self-hosted DREAM model runtime (OpenAI-compatible chat-completions protocol).
# Set to the native server API base including /v1, e.g. http://127.0.0.1:8090/v1.
# Leave blank until a model server controlled by DREAM is available.
DREAM_MODEL_URL=
DREAM_MODEL_NAME=
DREAM_MODEL_TOKEN=

# Native DREAM model runtime. Keep on localhost unless secured for remote use.
DREAM_RUNTIME_HOST=127.0.0.1
DREAM_RUNTIME_PORT=8081
DREAM_RUNTIME_TOKEN=

# Web application server
PORT=3000

# Optional private Google account integration (Gmail read-only).
# Register a Google OAuth web application and set the exact HTTPS callback URI:
# https://YOUR-DREAM-HOST/api/account/google/callback
# The client secret and encryption key are server-only; never expose them in browser code.
DREAM_GOOGLE_OAUTH_CLIENT_ID=
DREAM_GOOGLE_OAUTH_CLIENT_SECRET=
DREAM_GOOGLE_OAUTH_REDIRECT_URI=
# 32-byte AES-256 key encoded as 64 hex characters or base64. Generate securely.
DREAM_ACCOUNT_ENCRYPTION_KEY=
# Absolute path on a persistent disk/volume, e.g. /var/data/dream-ai/accounts.json.
DREAM_ACCOUNT_STORE_PATH=
# Set true only after verifying the path is on a durable persistent volume.
DREAM_ACCOUNT_STORE_PERSISTENT=false

# Optional Meta operator token for a server-side validity check only.
# It is never sent to browsers or used as a shared user-account credential.
META_ACCESS_TOKEN=
# Required to enable each visitor's own official Facebook/Instagram and Threads sign-in.
# Keep the App Secret private. Add these exact callback URLs in the Meta app settings.
META_APP_ID=
META_APP_SECRET=
META_FACEBOOK_REDIRECT_URI=https://YOUR-DREAM-HOST/api/account/meta/facebook/callback
META_THREADS_REDIRECT_URI=https://YOUR-DREAM-HOST/api/account/meta/threads/callback
