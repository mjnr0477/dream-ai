# Self-hosted DREAM model runtime (OpenAI-compatible chat-completions protocol).
# Set to the native server API base including /v1, e.g. http://127.0.0.1:8090/v1.
# Leave blank until a model server controlled by DREAM is available.
DREAM_MODEL_URL=
DREAM_MODEL_NAME=
DREAM_MODEL_TOKEN=

# Web application server
PORT=3000
