# Copy to native-gpu.env on the computer that will host the GPU.
# Never commit native-gpu.env or send its values in chat.

# Copy the exact 64-character server-side worker token from dream-host-live.
DREAM_HOST_WORKER_TOKEN=

# Copy the separate 64-character artifact token used by DREAM HOST's R2 vault.
# It must be different from DREAM_HOST_WORKER_TOKEN.
DREAM_HOST_ARTIFACT_TOKEN=

# SHA-256 of the already audited native DREAM instruction checkpoint in R2.
# The worker refuses unpinned or missing checkpoints.
DREAM_NATIVE_CHECKPOINT_SHA256=

# This must match the uploaded artifact name exactly.
DREAM_NATIVE_CHECKPOINT_ARTIFACT=dream-native-sft-checkpoint.pt
